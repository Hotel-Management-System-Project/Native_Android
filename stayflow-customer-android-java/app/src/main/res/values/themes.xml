<resources>
    <style name="Theme.StayFlow" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/background</item>
        <!-- Match the battery/time system bar with the red page header. -->
        <item name="android:statusBarColor">@color/primary_header</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>
    <style name="Theme.StayFlow.Splash" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
